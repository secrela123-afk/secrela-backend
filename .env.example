# Server
NODE_ENV=development
PORT=5005

# Comma-separated browser origins allowed to call the API (Next.js dev default)
CORS_ORIGINS=http://localhost:3010

# Local MongoDB (default). For Atlas, paste your connection string instead.
MONGODB_URI=mongodb://127.0.0.1:27017/securevault

# Session cookie (HttpOnly) — used by Authentication + Sessions
SESSION_COOKIE_NAME=sv_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
# lax = good default with cookie sessions + OAuth top-level redirects
COOKIE_SAMESITE=lax

# AES-256 key for TOTP secrets at rest (32 bytes, base64). NEVER commit the real value.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Dedicated KEK for org secret DEKs (AD-005). REQUIRED in production. MUST differ from TOTP key.
# SECRETS_ENCRYPTION_KEY=replace-with-another-32-byte-base64-key

# Frontend origin — used in verification + password-reset email links + OAuth return
APP_ORIGIN=http://localhost:3010
APP_NAME=Secrela

# ---------------------------------------------------------------------------
# Creem — current card checkout (Merchant of Record)
# Dashboard: https://www.creem.io (toggle Test Mode in the sidebar)
# Create 6 subscription products matching PLAN_PRICES_USD_CENTS:
# Starter $20 / $192 yearly, Team $60 / $576 yearly, Business $99 / $948 yearly.
# Webhook (test): https://YOUR_PUBLIC_API/api/v1/billing/webhooks/creem
# Local webhooks need a tunnel (ngrok). Returning to /app/billing?checkout=success also syncs.
# ---------------------------------------------------------------------------
CREEM_MODE=test
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_STARTER_MONTHLY=
CREEM_PRODUCT_STARTER_YEARLY=
CREEM_PRODUCT_TEAM_MONTHLY=
CREEM_PRODUCT_TEAM_YEARLY=
CREEM_PRODUCT_BUSINESS_MONTHLY=
CREEM_PRODUCT_BUSINESS_YEARLY=
# Dev only — skip Creem and activate in DB
# CREEM_ALLOW_MOCK_ACTIVATE=true

# ---------------------------------------------------------------------------
# Lemon Squeezy — PAUSED (routes commented; keep keys if you restore later)
