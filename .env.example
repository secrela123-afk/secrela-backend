# Server
NODE_ENV=development
PORT=5005

# Comma-separated browser origins allowed to call the API (Next.js dev default)
CORS_ORIGINS=http://localhost:3010

# Local MongoDB (default). For Atlas, paste your connection string instead.
MONGODB_URI=mongodb://127.0.0.1:27017/securevault

# Session cookie (HttpOnly) — used by Authentication + Sessions
SESSION_COOKIE_NAME=sv_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
# lax = good default with cookie sessions + OAuth top-level redirects
COOKIE_SAMESITE=lax

# AES-256 key for TOTP secrets at rest (32 bytes, base64). NEVER commit the real value.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Dedicated KEK for org secret DEKs (AD-005). REQUIRED in production. MUST differ from TOTP key.
# SECRETS_ENCRYPTION_KEY=replace-with-another-32-byte-base64-key

# Frontend origin — used in verification + password-reset email links + OAuth return
APP_ORIGIN=http://localhost:3010
APP_NAME=Secrela

# ---------------------------------------------------------------------------
# PayPal Subscriptions (current checkout)
# https://developer.paypal.com/dashboard/applications
# PAYPAL_MODE=sandbox for tests, live when the account can receive.
# Create 6 subscription plans in PayPal, then paste their plan IDs (P-...).
# ---------------------------------------------------------------------------
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# PAYPAL_WEBHOOK_ID=
# PAYPAL_PLAN_STARTER_MONTHLY=
# PAYPAL_PLAN_STARTER_YEARLY=
# PAYPAL_PLAN_TEAM_MONTHLY=
# PAYPAL_PLAN_TEAM_YEARLY=
# PAYPAL_PLAN_BUSINESS_MONTHLY=
# PAYPAL_PLAN_BUSINESS_YEARLY=
# Dev only — skip PayPal and activate in DB (default: false)
# PAYPAL_ALLOW_MOCK_ACTIVATE=true

# ---------------------------------------------------------------------------
# Paddle Billing (card overlay — second checkout option; PayPal stays)
# Sandbox: https://sandbox-vendors.paddle.com
# PADDLE_MODE=sandbox for tests, live when the seller account is approved.
# Set Default payment link in sandbox-vendors.paddle.com → Checkout → Checkout settings
# to http://localhost:3010/checkout (do not send checkout.url from the API).
# Create one-time prices (pri_...) matching PLAN_PRICES_USD_CENTS:
# Starter $20 / $192 yearly, Team $60 / $576 yearly, Business $99 / $948 yearly.
# ---------------------------------------------------------------------------
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_MODE=sandbox
# PADDLE_PRICE_STARTER_MONTHLY=
# PADDLE_PRICE_STARTER_YEARLY=
# PADDLE_PRICE_TEAM_MONTHLY=
# PADDLE_PRICE_TEAM_YEARLY=
# PADDLE_PRICE_BUSINESS_MONTHLY=
# PADDLE_PRICE_BUSINESS_YEARLY=

# ---------------------------------------------------------------------------
# Lemon Squeezy — DISABLED (kept for reference; checkout uses PayPal + Paddle)
# ---------------------------------------------------------------------------
# LEMON_SQUEEZY_API_KEY=eyJ...
# LEMON_SQUEEZY_STORE_ID=12345
# LEMON_SQUEEZY_WEBHOOK_SECRET=whsec_from_dashboard
# Create 4 subscription variants in Lemon, then paste their IDs:
# LEMON_SQUEEZY_VARIANT_STARTER_MONTHLY=
# LEMON_SQUEEZY_VARIANT_STARTER_YEARLY=
# LEMON_SQUEEZY_VARIANT_TEAM_MONTHLY=
# LEMON_SQUEEZY_VARIANT_TEAM_YEARLY=
# Dev only — skip Lemon and activate in DB (default: false)
# LEMON_SQUEEZY_ALLOW_MOCK_ACTIVATE=true

# Trust X-Forwarded-For only behind Nginx / a load balancer (default: true in production)
# TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Google OAuth (Sign in with Google)
# Console: https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# GOOGLE_REDIRECT_URI=http://localhost:5005/api/v1/auth/oauth/google/callback

# ---------------------------------------------------------------------------
# Email — Brevo (SMTP) for verify-email + forgot-password
# REQUIRED in production (EMAIL_ENABLED=true)
# https://www.brevo.com
# ---------------------------------------------------------------------------
EMAIL_ENABLED=false

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=b61651001@smtp-brevo.com
SMTP_PASS=xsmtpsib-your-brevo-smtp-key
EMAIL_FROM=Secrela <secrela123@gmail.com>
